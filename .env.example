# Copy to .env (git-ignored) and fill in what you need. Never commit real keys.
# Nothing here is required: with no keys at all, Relay starts and serves the built-in simulator
# models. Add a provider key to use a real one.

# ---- Provider keys: add the ones you have ------------------------------------------------------
GROQ_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
# Gemini's free tier may let Google use prompts: public data only.
GEMINI_API_KEY=

# ---- Docker Compose ----------------------------------------------------------------------------
# The gateway listens on 127.0.0.1:8000. To reach it from other machines, bind all interfaces
# (and put TLS in front of it):
# RELAY_BIND=0.0.0.0
# RELAY_PORT=8000
# Postgres is not published. Change its password before the first start (it cannot be changed
# by editing this file afterwards).
# POSTGRES_PASSWORD=relay

# ---- Observability (docker compose --profile observability up -d) ------------------------------
# GRAFANA_PASSWORD=
# RELAY_OTEL_ENDPOINT=http://otel-collector:4317

# ---- Gateway settings (all optional; each one is documented in guide/configuration.md) ---------
# RELAY_LOG_LEVEL=INFO
# Secrets are generated on the first start and kept in the relaydata volume. Set these only if
# you manage secrets yourself (they must then be the same on every replica):
# RELAY_KEY_PEPPER=
# RELAY_ADMIN_TOKEN=
# Turn the policy admin API on (its token is generated if RELAY_ADMIN_TOKEN is not set):
# RELAY_ADMIN_API=on
# The tenant the first API key is created for, printed once on the first start:
# RELAY_BOOTSTRAP_TENANT=dev
# Largest request body, in bytes (1 MiB):
# RELAY_MAX_BODY_BYTES=1048576
# Addresses of reverse proxies in front of Relay, comma-separated: only their X-Forwarded-For
# is believed by the per-IP limits.
# RELAY_TRUSTED_PROXIES=
# Use your own models, prices, routes and tenants:
# RELAY_CONFIG_PATH=/path/to/relay.yaml

# ---- Running the tests and tools from your own shell (not Docker) ------------------------------
# These match `make up` (docker-compose.dev.yml), which publishes Postgres and Redis on localhost.
# RELAY_DATABASE_URL=postgresql://relay:relay@localhost:5432/relay
# RELAY_REDIS_URL=redis://localhost:6379/0
