# Copy to .env (git-ignored) and fill in. Never commit real keys.

# Process settings (relay/settings.py), all prefixed RELAY_
RELAY_ENV=dev
RELAY_LOG_LEVEL=INFO
# Request logs. Unset = in-memory only. This URL matches the compose Postgres (make up),
# and is also what `make migrate` and `make test-integration` use.
RELAY_DATABASE_URL=postgresql://relay:relay@localhost:5432/relay
# API-key auth (Phase 5). The pepper must match the gateway's for keys made with
# `python -m relay.auth create-key`. For a quick run with no database and no keys,
# set RELAY_AUTH_DISABLED=true (dev/test only): every request is then tenant `dev`.
RELAY_KEY_PEPPER=local-dev-pepper-change-me
# RELAY_AUTH_DISABLED=true
# Shared admission state (Phase 6). Unset = in-process, one replica only.
RELAY_REDIS_URL=redis://localhost:6379/0

# Provider keys: needed from Phase 4. Tests never use them unless marked @pytest.mark.live.
GROQ_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
# Gemini's free tier may let Google use prompts: public data only (PRD §13).
GEMINI_API_KEY=
